+    _WALL_STUB = {"success": 0.0, "spl": 0.0, "oracle_success": 0.0,
+                  "distance_to_goal": -1.0, "oracle_navigation_error": -1.0, "path_length": -1.0}
+    _latest = {"infos": None, "num_steps": 0}   # updated each loop iteration
